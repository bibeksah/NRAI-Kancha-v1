# ==========================================
# 🤖 DeepSeek AI Configuration (NRAI Kancha)
# ==========================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ==========================================
# 🎙️ Azure Speech Services (Optional for TTS/STT)
# If not provided, Web Speech API will be used
# ==========================================
SPEECH_REGION=swedencentral
SPEECH_KEY=your_azure_speech_key_here
NEXT_PUBLIC_SPEECH_REGION=swedencentral
NEXT_PUBLIC_SPEECH_KEY=your_azure_speech_key_here
